node_modules/
frontend/dist/

runs/
runs-mock/
# holds LAN access codes in plaintext — must never be committed; the
# trailing * also covers save()'s temp file (printers.json<random>.tmp) so
# an interrupted write can't leak the access code past this rule
printers.json*
# per-printer queue state: no secrets, but user data — don't commit
queues.json*
# the traceability ledger + SQLite's -wal/-shm sidecars + quarantined
# ledger.db.corrupt-<stamp> files; user data, no secrets
ledger.db*
*.pt

# Large dataset files
3d-printing-failure-detection.v1i.yolov8/
*.zip
.gstack/
.superpowers/
# local Claude Code tooling config (per-machine permission allowlist)
.claude/

# collected training images: large, and regenerated by collect_dataset.py
datasets/

# --- desktop (Electron) build artifacts ---
/build/
/dist/
frontend/dist/
desktop/node_modules/
desktop/release/

# Local shared password for LAN serving (BAMBU_PASSWORD). Never commit.
.bambu-password
